# Local configuration — copy of .env.example. Never commit real secrets.
DATABASE_URL=mysql://dmojo:dmojo@localhost:3306/dmojo
STORAGE_DIR=./storage/event-media
# Set to true when the site is served over https (production).
COOKIE_SECURE=false
PORT=3000

# ── NTT DATA Payment Services (Atom) — UAT test credentials ──
# PAYMENT_PROVIDER=simulated skips the gateway entirely (offline demos only).
PAYMENT_PROVIDER=atom
ATOM_ENV=uat
# Public address of this site as the customer's browser sees it (Atom redirects back to it).
PUBLIC_BASE_URL=http://localhost:3000
ATOM_MERCHANT_ID=445842
ATOM_PASSWORD=Test@123
ATOM_PRODUCT=AIPAY
ATOM_REQ_HASH_KEY=KEY123657234
ATOM_RES_HASH_KEY=KEYRESP123657234
ATOM_REQ_ENC_KEY=A4476C2062FFA58980DC8F79EB6A799E
ATOM_REQ_SALT=A4476C2062FFA58980DC8F79EB6A799E
ATOM_RES_ENC_KEY=75AEF0FA1B94B3C10D4F5B268F757F11
ATOM_RES_SALT=75AEF0FA1B94B3C10D4F5B268F757F11
ATOM_AUTH_URL=https://paynetzuat.atomtech.in/ots/aipay/auth
ATOM_STATUS_URL=https://paynetzuat.atomtech.in/ots/v2/payment/status
ATOM_JS_URL=https://pgtest.atomtech.in/staticdata/ots/js/atomcheckout.js
# Used when a customer gave no email (Atom requires one).
ATOM_FALLBACK_EMAIL=noreply@dmojoart.in
