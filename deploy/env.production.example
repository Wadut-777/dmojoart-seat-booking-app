# Production settings. setup.sh copies this to /etc/dmojo.env (root-owned, mode 640).
DATABASE_URL=mysql://dmojo:__DB_PASS__@localhost:3306/dmojo
STORAGE_DIR=/var/lib/dmojo/event-media
COOKIE_SECURE=true
PORT=3000
HOST=127.0.0.1
NITRO_HOST=127.0.0.1
PUBLIC_BASE_URL=https://__DOMAIN__

# ── NTT DATA (Atom) — replace EVERY value below with the PRODUCTION details NTT DATA gives you ──
PAYMENT_PROVIDER=atom
ATOM_ENV=prod
ATOM_MERCHANT_ID=CHANGE_ME
ATOM_PASSWORD=CHANGE_ME
ATOM_PRODUCT=CHANGE_ME
ATOM_REQ_HASH_KEY=CHANGE_ME
ATOM_RES_HASH_KEY=CHANGE_ME
ATOM_REQ_ENC_KEY=CHANGE_ME
ATOM_REQ_SALT=CHANGE_ME
ATOM_RES_ENC_KEY=CHANGE_ME
ATOM_RES_SALT=CHANGE_ME
ATOM_AUTH_URL=CHANGE_ME
ATOM_STATUS_URL=CHANGE_ME
ATOM_JS_URL=CHANGE_ME
ATOM_FALLBACK_EMAIL=noreply@dmojoart.in

# ── Booking ──
BOOKING_HOLD_MINUTES=15
BOOKING_REF_PREFIX=PXL-2026-
